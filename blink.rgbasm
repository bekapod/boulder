include "utils.rgbinc"

def BLINK_FRAMES equ 30

section "blink_ram", wram0
wBlinkFrames: ds 1
wBlinkVisible: ds 1 ; 0 or 1
wBlinkDirty: ds 1 ; 1 = the vblank hook should redraw

export wBlinkVisible, wBlinkDirty

section "blink", rom0

; start a blink cycle: visible, counting down, nothing to redraw
; clobbers: a
Blink_Init:
  copy [wBlinkFrames], BLINK_FRAMES
  copy [wBlinkVisible], 1
  copy [wBlinkDirty], 0
  ret

; count down one frame. at zero toggle visibility and mark dirty
; clobbers: a
Blink_Tick:
  ld a, [wBlinkFrames]
  dec a
  ld [wBlinkFrames], a
  ret nz ; not time to toggle yet
  copy [wBlinkFrames], BLINK_FRAMES
  ld a, [wBlinkVisible]
  xor a, 1
  ld [wBlinkVisible], a
  copy [wBlinkDirty], 1
  ret

export Blink_Init, Blink_Tick
