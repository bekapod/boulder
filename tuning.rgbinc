if !def(TUNING_RGBINC)
def TUNING_RGBINC equ 1

def CYCLE_FRAMES equ 60

def MARKER_CYCLE_MIN equ 4
def MARKER_PAUSE_FRAMES equ 4

def BAR_INNER_WIDTH equ 64

def HIT_REWARD equ 10
def HIT_FREEZE_FRAMES equ 12 ; marker freeze on a hit - the spot flashes this long

def MISS_LIMIT equ 3
def MISS_PENALTY_DIV equ 10 ; a miss costs altitude / 10 (-10%, floor-rounded)
def MISS_FREEZE_FRAMES equ 4 ; a short stutter so a miss still reads as "registered"
def MISS_POSE_FRAMES equ 24 ; the stagger holds this long

def SLIP_FRAMES equ 30
def METRES_PER_SPEEDUP equ 10 ; every Xm climbed trims 1 frame off the cycle

def TUMBLE_FRAMES equ 75 ; the tumble plays this long before GAMEOVER
def TUMBLE_ACCEL equ 6 ; boulders gravity
def TUMBLE_FLINCH_FRAMES equ 15 ; flinch holds this long before despair sets in

def SWEET_SPOT_WIDTH equ 12
def SWEET_SPOT_MIN equ (BAR_INNER_WIDTH - SWEET_SPOT_WIDTH) / 2
def SWEET_SPOT_MAX equ SWEET_SPOT_MIN + SWEET_SPOT_WIDTH - 1

endc
