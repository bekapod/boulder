include "tiles.rgbinc"
include "utils.rgbinc"

def GAMEOVER_Y equ 62
def GAMEOVER_X equ 60
def RUN_Y equ 79
def BEST_Y equ 89
def LABEL_X equ 49
def VALUE_X equ 99
def NEWBEST_Y equ 106
def NEWBEST_X equ 60
def SPR_RUN_VALUE equ 12 ; slots 12-14: run digits, 15: M
def SPR_BEST_VALUE equ 20 ; slots 20-22: best digits, 23: M
def SPR_NEWBEST_FIRST equ 24 ; slots 24-32: NEW BEST!
def SPR_NEWBEST_COUNT equ 9

section "game_over_ram", wram0
wBest: ds 2 ; best peak this session
wNewBest: ds 1 ; 0 = no new best, 1 = new best

export wBest

section "game_over", rom0
GameOver_Init:
  DisableLCD

  ld hl, GameOverTileData
  ld de, _VRAM + TILE_FULLSCREEN_FIRST * 16
  ld bc, GameOverTileData_End - GameOverTileData
  call MemCopy

  ld de, GameOverMapData
  ld b, TILE_FULLSCREEN_FIRST
  call DrawMap

  ; record check
  ld a, [wBest]
  ld hl, wAltitude
  sub a, [hl]
  ld a, [wBest + 1]
  inc hl
  sbc a, [hl]
  jr c, .record
    xor a, a
    ld [wNewBest], a
    jr .compared
  .record:
    copy [wNewBest], 1
    ld a, [wAltitude]
    ld [wBest], a
    ld a, [wAltitude + 1]
    ld [wBest + 1], a
  .compared:

  call Blink_Init

  copy [rLCDC], LCDC_FLAGS
  call ClearShadowOAM

  ld hl, wShadowOAM

  ld b, GAMEOVER_Y
  ld c, GAMEOVER_X
  ld de, GameOverText
  call DrawTextSprites

  ld b, RUN_Y
  ld c, LABEL_X
  ld de, RunText
  call DrawTextSprites

  ld b, RUN_Y
  ld c, VALUE_X
  ld de, ValueText
  call DrawTextSprites

  ld b, BEST_Y
  ld c, LABEL_X
  ld de, BestText
  call DrawTextSprites

  ld b, BEST_Y
  ld c, VALUE_X
  ld de, ValueText
  call DrawTextSprites

  ld b, NEWBEST_Y
  ld c, NEWBEST_X
  ld de, NewBestText
  call DrawTextSprites

  ld a, [wAltitude]
  ld l, a
  ld a, [wAltitude + 1]
  ld h, a
  ld de, wShadowOAM + SPR_RUN_VALUE * 4 + OAMA_TILEID
  call DrawDigitSprites

  ld a, [wBest]
  ld l, a
  ld a, [wBest + 1]
  ld h, a
  ld de, wShadowOAM + SPR_BEST_VALUE * 4 + OAMA_TILEID
  call DrawDigitSprites

  ld a, [wNewBest]
  and a, a
  jr nz, .newbest_shown
  ld b, 0
  call SetNewBestSpritesY
  .newbest_shown:

  SetVblankFn VblankNop
  SwitchState GameOver_Update, STATE_GAMEOVER
  ret

GameOver_Update:
  ld a, [wNewBest]
  and a, a
  jr z, .no_blink
  call Blink_Tick
  ld a, [wBlinkDirty]
  and a, a
  jr z, .no_blink
  xor a, a
  ld [wBlinkDirty], a

  ld b, 0
  ld a, [wBlinkVisible]
  and a, a
  jr z, .apply
  ld b, NEWBEST_Y
  .apply:
  call SetNewBestSpritesY
  .no_blink:

  TestPadInput_Pressed wPadInput, PADF_START
  ret nz
  SetStateFn Play_Init
  ret

; set the y of all NEW BEST! sprites (0 = hidden offscreen)
; in: b = OAM y
; clobbers: a, c, h, l
SetNewBestSpritesY:
  ld hl, wShadowOAM + SPR_NEWBEST_FIRST * 4 + OAMA_Y
  ld c, SPR_NEWBEST_COUNT
  .spr:
    ld [hl], b
    ld a, l
    add a, sizeof_OAM_ATTRS
    ld l, a
    dec c
    jr nz, .spr
  ret

GameOverText: db "GAME OVER", TEXT_END
RunText: db "RUN", TEXT_END
BestText: db "BEST", TEXT_END
NewBestText: db "NEW BEST!", TEXT_END
ValueText: db "000M", TEXT_END

export GameOver_Init
