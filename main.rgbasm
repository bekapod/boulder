include "hardware.rgbinc"
include "tiles.rgbinc"
include "utils.rgbinc"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "header", rom0[$0100]
entrypoint:
  di
  jp main
  ds ($0150 - @), 0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "vblank_interrupt", rom0[$0040]
  reti

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "main_ram", wram0
; input struct
wPadInput:
wInputHeld:    ds 1   ; PAD_INPUT_CURRENT
               ds 1   ; PAD_INPUT_PREVIOUS (private)
wInputPressed: ds 1
               ds 1   ; PAD_INPUT_RELEASED (private)
wStateFn: ds 2
wStateId: ds 1
wVblankFn: ds 2 ; per-state vblank hook, see SetVblankFn

assert (wInputHeld - wPadInput) == PAD_INPUT_CURRENT
assert (wInputPressed - wPadInput) == PAD_INPUT_PRESSED
export wPadInput, wInputHeld, wInputPressed, wStateFn, wStateId, wVblankFn

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; a copy of OAM (40 sprites) that game code is free to
; write whenever it wants.
; align[8]: the DMA register is told only which 256-byte page to
; copy from, so this buffer must start exactly at the top of a page
section "shadow_oam", wram0, align[8]
wShadowOAM: ds OAM_COUNT * sizeof_OAM_ATTRS

export wShadowOAM

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "tiles", rom0
MarkerTileData:
  incbin "marker_obj.chr"
MarkerTileData_End:

BarTileData:
  incbin "bar_bg.chr"
BarTileData_End:

DigitsTileData:
  incbin "digits_bg.chr"
DigitsTileData_End:

BoulderTileData:
  incbin "boulder_obj.chr"
BoulderTileData_End:

SisyphusTileData:
  incbin "sisyphus_obj.chr"
SisyphusTileData_End:

SceneTileData:
  incbin "tileset.chr"
SceneTileData_End:

SceneMapData:
  incbin "scene_map.tlm"

TitleTileData:
  incbin "title.chr"
TitleTileData_End:

TitleMapData:
  incbin "title.tlm"

GameOverTileData:
  incbin "gameover.chr"
GameOverTileData_End:

GameOverMapData:
  incbin "gameover.tlm"

assert TILE_FULLSCREEN_FIRST + (TitleTileData_End - TitleTileData) / 16 <= 256, \
  "title tiles overflow the 256-tile table"
assert TILE_FULLSCREEN_FIRST + (GameOverTileData_End - GameOverTileData) / 16 <= 256, \
  "gameover tiles overflow the 256-tile table"

export SceneMapData, TitleMapData, TitleTileData, TitleTileData_End, GameOverMapData, GameOverTileData, GameOverTileData_End

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "main", rom0
main:
  DisableLCD
  InitPadInput wPadInput

  ; copy the DMA routine into HRAM b/c during DMA the CPU can only
  ; execute from HRAM, so the routine must be there and not in ROM
  ld hl, OamDmaFunction
  ld de, hOamDma
  ld bc, OamDmaFunction_End - OamDmaFunction
  call MemCopy

  ; the first DMA fires before any state's init runs, so the buffer
  ; must already be clean here
  call ClearShadowOAM

  ; load the art into specified tiles
  ; VRAM is only _freely_ writable while the LCD is off
  ld hl, MarkerTileData
  ld de, _VRAM + TILE_MARKER * 16
  ld bc, MarkerTileData_End - MarkerTileData
  call MemCopy

  ld hl, BarTileData
  ld de, _VRAM + TILE_BAR_FIRST * 16
  ld bc, BarTileData_End - BarTileData
  call MemCopy

  ld hl, DigitsTileData
  ld de, _VRAM + TILE_DIGIT_FIRST * 16
  ld bc, DigitsTileData_End - DigitsTileData
  call MemCopy

  ld hl, SceneTileData
  ld de, _VRAM + TILE_SCENE_FIRST * 16
  ld bc, SceneTileData_End - SceneTileData
  call MemCopy

  ld hl, BoulderTileData
  ld de, _VRAM + TILE_BOULDER_FIRST * 16
  ld bc, BoulderTileData_End - BoulderTileData
  call MemCopy

  ld hl, SisyphusTileData
  ld de, _VRAM + TILE_SISYPHUS_FIRST * 16
  ld bc, SisyphusTileData_End - SisyphusTileData
  call MemCopy

  ; wipe the boot ROM's leftover Nintendo logo from the tilemap
  ld hl, _SCRN0
  ld d, 0
  ld bc, 32 * 32
  call MemSet

  call Sfx_Init
  
  ; init the palette
  ld a, %11100100
  ld [rBGP], a
  ld [rOBP0], a
  ld a, %00011011
  ld [rOBP1], a

  ; set the graphics parameters and turn LCD back on
  ld a, LCDC_FLAGS
  ld [rLCDC], a

  ; enable the vblank interrupt
  ld a, IEF_VBLANK
  ld [rIE], a

  xor a
  ld [wBest], a
  ld [wBest + 1], a

  SetVblankFn VblankNop
  SwitchState Title_Init, STATE_TITLE

  ei

  .loop
    halt

    ; halt wakes on vblank, so this runs at the start of the vblank
    ; window - this is the only safe time to touch OAM
    call hOamDma

    call Sfx_Tick

    ; per-state vblank work (tilemap flushes, etc), still inside
    ; the vblank window
    ld a, [wVblankFn]
    ld l, a
    ld a, [wVblankFn + 1]
    ld h, a
    call CallHL

    UpdatePadInput wPadInput

    ld a, [wStateFn]
    ld l, a
    ld a, [wStateFn + 1]
    ld h, a
    ld de, .loop
    push de
    jp hl

  ; this code gets copied into HRAM on startup and runs there as hOamDma
  ; never called here in ROM. uses jr and not jp so it still works
  ; after moving. the loop is just a timer b/c the DMA has no "done" flag
  ; to check, this always takes 160 cycles (40 iterations of dec + jr)
  OamDmaFunction:
    ld a, high(wShadowOAM)
    ldh [rDMA], a

    ld a, 40
    .wait_dma:
      dec a
      jr nz, .wait_dma

    ret
  OamDmaFunction_End:

  ; hide all 40 sprites in the shadow OAM buffer. this is called at 
  ; startup and in every state's Init
  ClearShadowOAM:
    ld hl, wShadowOAM
    ld d, 0
    ld bc, OAM_COUNT * sizeof_OAM_ATTRS
    jp MemSet ; tail call, MemSet's own ret returns back to caller

  ; jump to the routine that hl points to. "call hl" doesn't exist as an
  ; instruction, so we call here and immediately jump to hl
  ; the hook's own ret then returns to whoever called it
  CallHL:
    jp hl

  ; the vblank hook for states with no vblank work
  VblankNop:
    ret

export ClearShadowOAM, VblankNop

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "hram", hram
hOamDma: ds OamDmaFunction_End - OamDmaFunction

export hOamDma
