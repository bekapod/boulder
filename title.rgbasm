include "utils.rgbinc"

section "title_ram", wram0

section "title", rom0
Title_Init:
  call ClearShadowOAM
  SetVblankFn VblankNop
  SwitchState Title_Update, STATE_TITLE
  ret

Title_Update:
  TestPadInput_Pressed wPadInput, PADF_START
  ret nz
  SwitchState Play_Init, STATE_PLAY
  ret

export Title_Init
