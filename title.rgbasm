include "tiles.rgbinc"
include "utils.rgbinc"

def BLINK_ROW equ 16
def BLINK_COL equ 6
def BLINK_WIDTH equ 8

section "title", rom0
Title_Init:
  DisableLCD

  ld hl, TitleTileData
  ld de, _VRAM + TILE_FULLSCREEN_FIRST * 16
  ld bc, TitleTileData_End - TitleTileData
  call MemCopy
  
  ; draw the title
  ld de, TitleMapData
  ld b, TILE_FULLSCREEN_FIRST
  call DrawMap

  copy [rLCDC], LCDC_FLAGS
  call ClearShadowOAM
  call Blink_Init
  SetVblankFn Title_Vblank
  SwitchState Title_Update, STATE_TITLE
  ret

Title_Vblank:
  ld a, [wBlinkDirty]
  and a, a
  ret z
  xor a
  ld [wBlinkDirty], a

  ld de, TitleMapData + (BLINK_ROW + 1) * SCRN_X_B + BLINK_COL
  ld a, [wBlinkVisible]
  and a, a
  jr z, .copy
  ld de, TitleMapData + BLINK_ROW * SCRN_X_B + BLINK_COL

  .copy:
  ld hl, _SCRN0 + BLINK_ROW * SCRN_VX_B + BLINK_COL
  ld b, TILE_FULLSCREEN_FIRST
  ld c, BLINK_WIDTH
  jp DrawMapCells ; tail call

Title_Update:
  call Blink_Tick
  TestPadInput_Pressed wPadInput, PADF_START
  ret nz
  SetStateFn Play_Init
  ret

export Title_Init
