if !def(TILES_RGBINC)
def TILES_RGBINC equ 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

include "hardware.rgbinc"
include "tuning.rgbinc"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

def BAR_BORDER_PX equ 4 ; border cap in the bar art before track pixel 0
def BAR_TILE_COL equ 1
def BAR_TILE_ROW equ 16
def BAR_WIDTH_TILES equ 9

; which VRAM tile slots hold which art
; slot 0 stays blank b/c empty tilemap cells point at it
def TILE_MARKER equ 1
def TILE_BAR_FIRST equ 2
def TILE_BAR_DARK_FIRST equ TILE_BAR_FIRST + 9 ; dark variants of bar tiles 3..5

def TILE_DIGIT_FIRST equ TILE_BAR_DARK_FIRST + 3
def TILE_LETTER_M equ TILE_DIGIT_FIRST + 10
def TILE_BOULDER_FIRST equ TILE_LETTER_M + 1
def TILE_SISYPHUS_FIRST equ TILE_BOULDER_FIRST + 4
def TILE_SCENE_FIRST equ TILE_SISYPHUS_FIRST + 4

def ALTITUDE_MAP_ADDR equ _SCRN0 + 1 * 32 + 15

; the sweet spot sits over these bar tiles (relative to the bar's left tile)
def FLASH_TILE_OFFSET equ 3
def FLASH_TILE_COUNT equ 3

; tripwires: the flash tiles must be exactly the tiles the sweet spot
; covers. the spot is in bar-track pixels. + BAR_BORDER_PX converts to
; pixels within the bar tiles, / 8 converts pixels to a tile index
assert FLASH_TILE_OFFSET == (SWEET_SPOT_MIN + BAR_BORDER_PX) / 8, \
  "FLASH_TILE_OFFSET no longer matches SWEET_SPOT_MIN"
assert FLASH_TILE_COUNT == (SWEET_SPOT_MAX + BAR_BORDER_PX) / 8 - FLASH_TILE_OFFSET + 1, \
  "FLASH_TILE_COUNT no longer covers the sweet spot"
assert FLASH_TILE_COUNT == 3, \
  "the dark bar art and FlushFlashTiles' unrolled writes assume 3 tiles"

endc
