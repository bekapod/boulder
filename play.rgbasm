include "tiles.rgbinc"
include "tuning.rgbinc"
include "utils.rgbinc"

def MARKER_WIDTH equ 8
def MARKER_TIP equ MARKER_WIDTH / 2
; bar tile x + border + OAM offset
def MARKER_OAM_X_BASE equ BAR_TILE_COL * 8 + 4 + 8 - MARKER_TIP
def MARKER_OAM_Y equ BAR_TILE_ROW * 8 + 5 + 16 ; 5 = 8px row minus 3px overlap into the bar

section "play_ram", wram0
wMarkerDir: ds 1
wMarkerPos: ds 2 ; 8.8 fixed-point: +0 = fraction, +1 = whole pixels
wMarkerPause: ds 1
wCycleFrames: ds 1
wAltitude: ds 2
wMissStreak: ds 1 ; counts consecutive misses, 0..3
wPressUsed: ds 1 ; has a button been pressed in this sweep? 0 = no, 1 = yes
wSlipCounter: ds 1 ; counts frames 0..29, resets at SLIP_FRAMES
wFlashFrames: ds 1 ; counts frames to flash the sweet spot on a hit, 0 = not flashing
wAltitudeDigits: ds 3 ; hundreds, tens, ones, blank-padded
wAltitudeDirty: ds 1 ; 0 = no change, 1 = update the display

export wMarkerDir, wMarkerPos, wCycleFrames, wAltitude, wMissStreak, wAltitudeDigits, wAltitudeDirty

section "play", rom0
Play_Init:
  ; draw the bar
  ; needs to be first b/c VRAM writes only stick while the PPU isn't drawing
  ; and we're at the top of vblank, biggest safe window
  ld hl, _SCRN0 + BAR_TILE_ROW * 32 + BAR_TILE_COL
  ld a, TILE_BAR_FIRST

  .draw_bar:
    ld [hli], a ; write a into hl, then increment hl by 1
    inc a
    cp a, TILE_BAR_FIRST + BAR_WIDTH_TILES
    jr nz, .draw_bar

  ld a, TILE_LETTER_M
  ld [ALTITUDE_MAP_ADDR + 3], a

  call ClearShadowOAM
  copy [wShadowOAM + OAMA_Y], MARKER_OAM_Y
  copy [wShadowOAM + OAMA_X], MARKER_OAM_X_BASE
  copy [wShadowOAM + OAMA_TILEID], TILE_MARKER
  copy [wShadowOAM + OAMA_FLAGS], 0 ; attrs 0 = no flips, in front of BG, OBP0 (object palette 0)
  copy [wMarkerDir], 0 ; 0 = moving right, 1 = moving left
  copy [wMarkerPos], 0
  copy [wMarkerPos + 1], 0
  copy [wMarkerPause], 0
  copy [wCycleFrames], CYCLE_FRAMES
  copy [wAltitude], 0
  copy [wAltitude + 1], 0
  copy [wMissStreak], 0
  copy [wPressUsed], 0
  copy [wSlipCounter], 0
  copy [wFlashFrames], 0

  call UpdateAltitudeDisplay

  SwitchState Play_Update, STATE_PLAY
  ret

Play_Update:
  call UpdateFlash
  call UpdateSlip
  call MoveMarker
  call RenderMarker ; out: b = marker screen position
  call JudgePress ; in: b = marker screen position
  ret

; count down the sweet-spot flash. while it runs, the three bar tiles
; under the spot point at the dark variants, back to light when it ends
; clobbers: a, h, l
UpdateFlash:
  ld a, [wFlashFrames]
  and a, a
  ret z ; no flash running
  dec a
  ld [wFlashFrames], a
  ld hl, _SCRN0 + BAR_TILE_ROW * 32 + BAR_TILE_COL + FLASH_TILE_OFFSET
  ld a, TILE_BAR_DARK_FIRST
  jr nz, .write ; still flashing -> dark set
  ld a, TILE_BAR_FIRST + FLASH_TILE_OFFSET ; just hit zero -> light set
  .write:
  ld [hli], a
  inc a
  ld [hli], a
  inc a
  ld [hl], a
  ret

; lost 1m of altitude every SLIP_FRAMES frames, clamped at 0
; clobbers: a, b, c, d, e, h, l
UpdateSlip:
  ld a, [wSlipCounter]
  inc a
  ld [wSlipCounter], a
  cp a, SLIP_FRAMES
  ret c ; not time yet
  copy [wSlipCounter], 0
  ld a, [wAltitude] ; is altitude 0?
  ld b, a
  ld a, [wAltitude + 1]
  or a, b ; 0 only if neither byte has any bits set
  ret z ; already at the bottom -> clamp, don't wrap
  ld de, 1
  jp Altitude_Sub

; how many times does c fit into wAltitude? (division by repeated subtraction)
; in: c = divisor
; out: de = quotient, hl = remainder
; clobbers: a, d, e, h, l
DivAltitude:
  ld a, [wAltitude]
  ld l, a
  ld a, [wAltitude + 1]
  ld h, a
  ; no jump, execution continues into Div16by8 below

; hl / c -> de = quotient, hl = remainder (0..c-1)
; clobbers: a
Div16by8:
  ld de, 0
  .fit:
    ld a, l ; hl = hl - c, 16-bit subtract: low byte first
    sub a, c
    ld l, a
    ld a, h
    sbc a, 0 ; high byte pays the borrow
    ld h, a
    jr c, .undo ; borrowed past zero -> didn't fit
    inc de
    jr .fit
  .undo: ; add c back so hl holds the real leftover
    ld a, l
    add a, c
    ld l, a
    ld a, h
    adc a, 0 ; and the carry un-pays the borrow -> h back to 0
    ld h, a
  ret

; rebuild wAltitudeDigits from wAltitude and raise the dirty flag
; blank-padded, display clamps at 999
; clobbers: a, b, c, h, l
UpdateAltitudeDisplay:
  ld a, [wAltitude]
  ld l, a
  ld a, [wAltitude + 1]
  ld h, a
  ld a, h
  cp a, high(1000)
  jr c, .no_clamp ; high byte below $03 -> at most 767, fine
  jr nz, .clamp ; high byte above $03 -> 1024+, clamp
  ld a, l
  cp a, low(1000)
  jr c, .no_clamp ; $03xx but below 1000, fine
  .clamp:
    ld hl, 999
  .no_clamp:

  ; hl = clamped altitude (from the clamp code above, unchanged)
  ld c, 100
  call Div16by8 ; e = how many 100s, hl = what's left (0..99)
  ld b, e ; stash hundreds in b
  ld c, 10
  call Div16by8 ; e = how many 10s, l = what's left (0..9)
  ld c, e ; c = tens
  ; b = hundreds, c = tens, l = ones

  ; hundreds cell: blank when the digit is 0
  ld a, b
  and a, a
  jr z, .store_hundreds ; a is already 0 = the blank tile
  add a, TILE_DIGIT_FIRST
  .store_hundreds
  ld [wAltitudeDigits], a

  ; tens cell: blank only when hundreds AND tens are both 0
  ld a, b
  or a, c
  jr z, .store_tens ; both zero -> a = 0 = blank
  ld a, c
  add a, TILE_DIGIT_FIRST
  .store_tens
  ld [wAltitudeDigits + 1], a

  ; ones cell: always a digit, so "0 M" shows a real zero
  ld a, l
  add a, TILE_DIGIT_FIRST
  ld [wAltitudeDigits + 2], a

  copy [wAltitudeDirty], 1
  ret

; altitude += de, then republish the display
; clobbers: a, b, c, d, e, h, l
Altitude_Add:
  ld a, [wAltitude]
  add a, e ; low byte first
  ld [wAltitude], a
  ld a, [wAltitude + 1]
  adc a, d ; carry spills into the high byte
  ld [wAltitude + 1], a
  jp UpdateAltitudeDisplay ; tail call, its ret returns to our caller

; altitude -= de, then republish the display
; clobbers: a, b, c, d, e, h, l
Altitude_Sub:
  ld a, [wAltitude]
  sub a, e ; low byte first
  ld [wAltitude], a
  ld a, [wAltitude + 1]
  sbc a, d ; borrow comes out of the high byte 
  ld [wAltitude + 1], a
  jp UpdateAltitudeDisplay ; tail call, its ret returns to our caller

; judge one A press per sweep against the sweet spot
; note: presses during the endpoint pause are ignored
; in: b = marker screen position in bar pixels (0..BAR_INNER_WIDTH)
; clobbers: a, b, c, d, e, h, l
JudgePress:
  ld a, [wMarkerPause]
  and a, a
  ret nz ; frozen at an endpoint -> no judgment this frame

  TestPadInput_Pressed wPadInput, PADF_A
  ret nz ; A wasn't pressed this frame -> nothing to judge
  ld a, [wPressUsed]
  and a, a
  ret nz ; this sweep already judged -> extra presses ignored
  copy [wPressUsed], 1 ; mark that a press has been used for this sweep
  ld a, b ; b = marker's screen position
  cp a, SWEET_SPOT_MIN
  jr c, .miss ; marker was left of the spot
  cp a, SWEET_SPOT_MAX + 1
  jr nc, .miss ; marker was right of the spot

  .hit:
    copy [wMissStreak], 0 ; reset the miss streak
    copy [wMarkerPause], HIT_FREEZE_FRAMES ; freeze the marker for a few frames
    copy [wFlashFrames], HIT_FREEZE_FRAMES ; flash the sweet spot for a few frames
    ld a, SFX_CHIME
    call Sfx_Play
    ld de, HIT_REWARD
    jp Altitude_Add

  .miss:
  ld a, SFX_THUD
  call Sfx_Play
    ld c, MISS_PENALTY_DIV
    call DivAltitude ; de = penalty = altitude / 5
    call Altitude_Sub ; charge it and republish
    copy [wMarkerPause], MISS_FREEZE_FRAMES
    ld a, [wMissStreak]
    inc a
    ld [wMissStreak], a
    cp a, MISS_LIMIT
    ret c ; survived: display already updated
    SwitchState GameOver_Init, STATE_GAMEOVER
    ret

; move the marker sprite to match wMarkerPos/wMarkerDir
; out: b = marker screen position in bar pixels (0..BAR_INNER_WIDTH)
; clobbers: a
RenderMarker:
  ; round progress to whole pixels: carry = "fraction >= 0.5"
  ld a, [wMarkerPos]
  add a, 128
  ld a, [wMarkerPos + 1]
  adc a, 0 ; a = 0..BAR_INNER_WIDTH whole pixels of progress
  ld b, a
  ld a, [wMarkerDir]
  and a, a
  jr z, .from_left ; dir 0: progress measures from the left
  ld a, BAR_INNER_WIDTH ; dir 1: mirror it, measure from the right
  sub a, b
  ld b, a
  .from_left:
  ld a, b
  add a, MARKER_OAM_X_BASE
  ld [wShadowOAM + OAMA_X], a
  ret

; wCycleFrames = CYCLE_FRAMES - altitude / METRES_PER_SPEEDUP,
; floored at MARKER_CYCLE_MIN; recomputed from altitude
; clobbers: a, c, d, e, h, l
RecomputeCycle:
  ld c, METRES_PER_SPEEDUP
  call DivAltitude ; de = altitude / METRES_PER_SPEEDUP
  ld a, d
  and a, a
  jr nz, .floor ; quotient > 255 -> miles past the floor
  ld a, e
  cp a, CYCLE_FRAMES - MARKER_CYCLE_MIN + 1
  jr c, .keep ; quotient <= 56 -> inside the allowed range
  .floor:
  ld e, CYCLE_FRAMES - MARKER_CYCLE_MIN
  .keep:
  ld a, CYCLE_FRAMES
  sub a, e
  ld [wCycleFrames], a
  ret

; tick the endpoint pause or advance the marker one frame; at the
; end of a sweep: reset, re-speed, turn around, start the pause
; clobbers: a, b, c, d, e, h, l
MoveMarker:
  ; pause check
  ld a, [wMarkerPause] ; 0 = not pausing, else frames left to wait
  and a, a ; zero-test, nothing changes in a but it sets flags as side-effect, zero flag is now "was a zero?"
  jr z, .not_paused
  dec a
  ld [wMarkerPause], a ; decrement by one frame and re-store
  ret ; frozen: skip movement but still draw

  .not_paused:
  ld a, [wCycleFrames]

  sub a, MARKER_CYCLE_MIN ; converts a cycle value (4..60) to an entry number (0..56)
  add a, a ; * 2 - each entry is two bytes
  ld e, a
  ld d, 0 ; de = byte offset, widened from 8 bits to 16 bits
  ld hl, MarkerIncrements
  add hl, de ; hl -> this cycle's entry
  ld a, [hli]
  ld e, a
  ld d, [hl]

  ; wMarkerPos is progress through the current sweep, 8.8 fixed-point,
  ; always counting up from 0 to BAR_INNER_WIDTH. add the increment to
  ; the fraction byte first; if it spills over, the carry flag remembers
  ; and adc passes the spill into the whole-pixel byte
  ld a, [wMarkerPos]
  add a, e
  ld [wMarkerPos], a
  ld a, [wMarkerPos + 1]
  adc a, d
  ld [wMarkerPos + 1], a
  cp a, BAR_INNER_WIDTH
  ret c
  .sweep_ended: ; restart progress for the next sweep and turn around
    copy [wMarkerPos], 0
    copy [wMarkerPos + 1], 0
    copy [wPressUsed], 0 ; reset the press-used flag for the next sweep

    call RecomputeCycle

    ld a, [wMarkerDir]
    xor a, 1 ; flip 0 <-> 1
    ld [wMarkerDir], a
    copy [wMarkerPause], MARKER_PAUSE_FRAMES
    ret

; copy the digit cells to the tilemap if they changed since last flush
; VBLANK ONLY
; clobbers: a
FlushAltitudeDigits:
  ld a, [wAltitudeDirty]
  and a, a
  ret z ; nothing changed
  ld a, [wAltitudeDigits]
  ld [ALTITUDE_MAP_ADDR], a
  ld a, [wAltitudeDigits + 1]
  ld [ALTITUDE_MAP_ADDR + 1], a
  ld a, [wAltitudeDigits + 2]
  ld [ALTITUDE_MAP_ADDR + 2], a
  xor a, a
  ld [wAltitudeDirty], a
  ret

; each entry is "to cross the bar's inner width in CYCLE frames
; how much do I add per frame?
MarkerIncrements:
  for CYCLE, MARKER_CYCLE_MIN, CYCLE_FRAMES + 1
    dw (BAR_INNER_WIDTH * 256 + CYCLE - 1) / CYCLE
  endr

export Play_Init, FlushAltitudeDigits
